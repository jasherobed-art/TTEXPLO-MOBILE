# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SYNC_HMAC_KEY: clave HMAC-SHA256 para autenticar paquetes QR de sincronización (BuildConfig.SYNC_HMAC_KEY).
# Clave NUEVA e independiente: NUNCA reutilizar MASTER_SECRET (sistema de licencias, fuera de alcance).
# Valor de DESARROLLO; en producción sobrescribir desde .env (no versionado). Al estar en el APK es
# ofuscación, no secreto perfecto; rotarla aquí no afecta a las licencias.
SYNC_HMAC_KEY=dev-sync-hmac-key-2026-11-22
